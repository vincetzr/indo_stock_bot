//@version=6
// =============================================================================
//  IDX SUITE  —  Hull ribbon, EMA stack, and a MEASURED price×time projection
// =============================================================================
//
//  WHAT THIS IS
//  ------------
//  Four layers on any IDX chart, labelled by how much they can be trusted:
//
//    [EXACT]      IDX mechanics — fraksi harga, auto-rejection levels, max
//                 price step, round-trip cost. Arithmetic from published rules.
//    [STATE]      Where the name is — volatility and its rank across IDX,
//                 distance from the 52-week high, drawdown, trend stack.
//    [MEASURED]   What that state implied historically, from 2,465,286 IDX
//                 bars over 891 names, 2000-2024. Frequencies, not forecasts.
//    [DRAWN]      Flip labels. Drawn because they were asked for, and carrying
//                 the measurement that says not to trade them.
//
//  THE PROJECTION IS THE POINT OF THIS VERSION.
//  Ask a target — say +20% — and the panel answers three things measured on
//  IDX rather than asserted: how likely price touches it inside a year, how
//  likely it touches the mirror-image loss FIRST-PASSAGE, and the date band in
//  which the touch lands if it comes. The band is a QUARTILE band: half of the
//  cases that reach the target do so between the two dates shown.
//
//  WHY A BAND AND NOT A DATE — THE TIME-CYCLE TEST, AND IT FAILED
//  ---------------------------------------------------------------
//  The premise behind a time-projection method is that turning points recur on
//  a schedule. That was tested three ways on this data and it does not:
//    * ZigZag pivot spacing is 68% MORE dispersed than a block-bootstrap of the
//      same returns (CV 2.246 against 1.340, z = +32.7). Cycles make spacing
//      MORE regular; IDX's is less.
//    * The memory that IS in the spacing is volatility clustering, not a
//      period: lengthen the bootstrap block to a year and the null reproduces
//      87% of it (excess R2 0.016, z = +1.64, not significant).
//    * The IHSG has no dominant period. Strongest is 885 sessions, peak/mean
//      power 140 against a null of 152 +/- 57, p = 0.499 — WEAKER than the
//      median scrambled control.
//    * Month-of-year pivot share runs 0.865 to 1.097. There is no calendar.
//  Knowing a name's entire history of turn spacings narrows the 50% band for
//  its next turn from +/-140% of the median gap to +/-125%. That is the whole
//  value of the time half, and it is why this plots a band and never a date.
//
//  AND THE STATE DOES NOT MOVE THE CLOCK, WHICH IS THE OTHER HALF.
//  Median sessions to +20%, by state: base 54, EMA-stacked 54, not stacked 54,
//  Hull rising 53. A confirmed uptrend changes the ODDS of getting there and
//  moves the timing by one session. Only volatility moves the clock — 89
//  sessions in the calmest decile against 30 in the wildest — so the date band
//  here is computed from THIS NAME'S OWN volatility, which is the only input
//  that was measured to matter.
//
//  WHAT THE FLIP LABELS ARE WORTH: LESS THAN NOTHING.
//  60-session hold, net of 56 bps, mean log return:
//    any eligible bar, no toll ... -0.0140     <- the benchmark
//    EMA stack turns on .......... -0.0124
//    Hull-55 slope turns up ...... -0.0148
//    HMA-21 crosses over HMA-55 .. -0.0191     <- the classic signal, the worst
//  The published Hull Suite + UT Bot rule was also scored on 84 IDX names over
//  240 configurations: best median excess CAGR -6.1%, beat buy-and-hold on 26%
//  of names, and lost to it in all five walk-forward folds. The labels are here
//  because a chart is for looking at. They are not an entry system.
//
//  THE HONEST HEADER
//    * Every probability is IN-SAMPLE. The out-of-sample holdout was spent.
//    * Every probability is a ONE-YEAR (252-session) figure, and the top of the
//      date band is partly that ceiling rather than the market.
//    * Set the chart to DAILY. Every constant was fitted on daily IDX bars and
//      the projection greys itself out on any other timeframe.
//    * This is a research instrument, not advice, and nothing in it has a live
//      track record.
//
//  Sources: H19/H22/H26/H30/H31/H32/H33 and reports/time_price.md,
//  reports/ema_cross_idx.md, reports/asymmetry.md in the research repository.
// =============================================================================

indicator("IDX Suite", "IDX Suite", overlay = true,
     max_labels_count = 500, max_boxes_count = 20, max_lines_count = 50)

// ----------------------------------------------------------------- inputs --
gM = "Panel"
showPanel = input.bool(true, "Show panel", group = gM)
panelPos  = input.string("Top right", "Panel position",
     options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = gM)
txtSize   = input.string("Small", "Text size",
     options = ["Tiny", "Small", "Normal"], group = gM)

gP = "Projection (H32, measured on 2.4m IDX bars)"
showProj = input.bool(true, "Draw the price x time cone", group = gP)
tgtPct   = input.float(20.0, "Target move %", minval = 5.0, maxval = 100.0,
     step = 1.0, group = gP,
     tooltip = "The projection answers: how often did an IDX name that looked " +
               "like this touch +X% within a year, how often did it touch -X% " +
               "instead, and when. The fit covers +5% to +100%; outside that " +
               "the panel says EXTRAPOLATED and you should not use it.")
showDown = input.bool(true, "Draw the mirror downside box", group = gP,
     tooltip = "A target quoted without its matching downside odds is half a " +
               "trade. At the base rate an IDX name is very nearly as likely " +
               "to touch -20% as +20% (0.560 against 0.567).")

gH = "Hull ribbon"
showHull = input.bool(true, "Show the Hull ribbon", group = gH)
hullLen  = input.int(55, "Hull length", minval = 4, group = gH)
hullMode = input.string("HMA", "Hull type", options = ["HMA", "EHMA"], group = gH)

gE = "EMA stack (H30, gridded on IDX)"
showEma  = input.bool(true, "Show the EMA stack", group = gE)
emaSig   = input.int(34, "Signal EMA (the one you watch)", minval = 2, group = gE,
     tooltip = "Drawn but NOT part of any measured statistic here. 34 is the " +
               "conventional default and is left as one.")
emaFast  = input.int(50,  "Fast EMA", minval = 2, group = gE)
emaMid   = input.int(100, "Mid EMA",  minval = 3, group = gE)
emaSlow  = input.int(200, "Slow EMA", minval = 4, group = gE,
     tooltip = "50/100/200 is here because it was GRIDDED on IDX -- 36 " +
               "(fast, mid, slow) combinations over 744 names and 5,879 " +
               "sessions -- not because it is conventional. The winner was " +
               "the STATE price>50>100>200, on mean log return.")
tintStack = input.bool(true, "Tint the background by stack state", group = gE)

gL = "Flip labels"
sigSrc = input.string("EMA34 break", "Label these flips",
     options = ["EMA34 break", "EMA stack", "Hull slope", "Dual Hull cross",
      "None"], group = gL,
     tooltip = "TWO DIFFERENT MEASUREMENTS, AND THEY PICK DIFFERENT WINNERS.\n\n" +
               "As a TURN DETECTOR (H37, 47,002 confirmed 10% swing highs, " +
               "flip within 30 sessions, against a null with the same flip " +
               "count): EMA34 recall 0.852 precision 0.583 F1 0.692 " +
               "(null 0.554); Hull-55 slope 0.812/0.589/0.683 (null 0.472); " +
               "EMA50 0.758/0.593/0.666; dual Hull 0.825/0.523/0.640; the EMA " +
               "stack only 0.348/0.614/0.445 -- its recall is BELOW its own " +
               "null. EMA34 is the most accurate flip of the five.\n\n" +
               "As an ENTRY (H33, 60-session hold net of 56bps, mean log, " +
               "against -0.0140 for holding any eligible bar): EMA stack " +
               "-0.0124, Hull slope -0.0148, dual Hull cross -0.0191. NONE " +
               "compounds. Accurate at spotting the turn is not the same as " +
               "profitable to trade, and this indicator says so out loud.")

gC = "Costs (your actual broker schedule)"
feeBuy  = input.float(0.28, "Buy commission %",  minval = 0, step = 0.01, group = gC,
     tooltip = "Default is the Mandiri retail schedule the research uses: " +
               "0.28 buy, 0.18 sell, 0.10 sell tax = 0.56% round trip.")
feeSell = input.float(0.18, "Sell commission %", minval = 0, step = 0.01, group = gC)
feeTax  = input.float(0.10, "Sell tax %",        minval = 0, step = 0.01, group = gC)

gB = "IDX board"
boardIn = input.string("Auto", "Auto-rejection board",
     options = ["Auto", "Main", "Thin (Pemantauan Khusus / Akselerasi)"], group = gB,
     tooltip = "The thin board trades a FLAT +/-10% band; the main board is " +
               "+35/25/20% up against a flat -15% down. Using the main ladder " +
               "on a thin-board name allows moves that cannot happen -- a real " +
               "bug in the research repo that affected 41 of 818 names. Auto " +
               "infers from the 6-month average price (IDX's own sub-Rp51 " +
               "watchlist rule), which is a guess, so override it if you know.")

// ------------------------------------------------------------ [STATE] core --
// SAMPLE stdev (ddof=1) of SIMPLE daily returns over 60 bars, NOT annualised.
// The projection laws are fitted in exactly this quantity, so Pine's default
// population form would feed them a number ~0.8% low and quietly shift the
// whole date band.
ret1   = close / close[1] - 1.0
vol60  = ta.stdev(ret1, 60, false)
volAnn = vol60 * math.sqrt(252)

hi252 = ta.highest(close, 252)
hi52  = close / hi252
ddPk  = close / hi252 - 1.0
rpDay = ta.median(close * volume, 20)
// H44's LIQUIDITY GATE, and it is the most important row on this panel.
// Every apparent edge in the simple-method sweep -- EMA, stochastic, breakout
// -- lived BELOW this line and inverted above it. The rank IC of a stochastic
// against the forward return is +0.072 in the bottom turnover tercile and
// -0.0021 (t = -0.15) in the top one, and it rises with price STALENESS
// (+0.099 for names flat more than 30% of the month), which is non-synchronous
// trading rather than forecasting. On names that clear this gate the same
// rules finish BELOW the pool they are drawn from.
rp60      = ta.median(close * volume, 60)
tradeable = close >= 500 and rp60 >= 1e10

// Where this name's volatility sits across IDX, from the measured decile edges
// of 623,126 eligible name-days. Context, and the reason the date band moves.
volDecile(float v) =>
    v <= 0.0145 ? 1 : v <= 0.0179 ? 2 : v <= 0.0205 ? 3 : v <= 0.0230 ? 4 :
     v <= 0.0256 ? 5 : v <= 0.0289 ? 6 : v <= 0.0331 ? 7 : v <= 0.0393 ? 8 :
     v <= 0.0509 ? 9 : 10

// ------------------------------------------------------ [EXACT] IDX ladders --
// Fraksi harga, Kep-00023/BEI/04-2016, reaffirmed Kep-00003/BEI/04-2025.
tickOf(float p) =>
    p < 200 ? 1.0 : p < 500 ? 2.0 : p < 2000 ? 5.0 : p < 5000 ? 10.0 : 25.0
// Jenjang maksimum perubahan harga — the largest single step an order may move
// the price. A different constraint from the tick and from auto-rejection.
maxStepOf(float p) =>
    p < 200 ? 10.0 : p < 500 ? 20.0 : p < 2000 ? 50.0 : p < 5000 ? 100.0 : 250.0
// Auto-rejection. The ceiling has not moved in the covered period; every change
// since 2020 has been to the floor, now a flat 15% (effective 2025-04-08).
araMain(float p) => p < 200 ? 0.35 : p < 5000 ? 0.25 : 0.20
araThin(float p) => 0.10

// ta.* must run on EVERY bar to keep its internal state correct, so this is
// hoisted rather than left inside a short-circuiting `or`.
avg126 = ta.sma(close, 126)
isThin = boardIn == "Thin (Pemantauan Khusus / Akselerasi)" or
         (boardIn == "Auto" and not na(avg126) and avg126 < 51)

tick    = tickOf(close)
maxStep = maxStepOf(close)
araPct  = isThin ? araThin(close) : araMain(close)
arbPct  = isThin ? 0.10 : 0.15
araLvl  = math.floor(close * (1 + araPct) / tick) * tick
arbLvl  = math.ceil (close * (1 - arbPct) / tick) * tick

// Half a tick is the OPTIMISTIC spread — it assumes a one-tick book, which is
// roughly right on a large cap and generous on a small one. A floor, not an
// estimate; the true cost is worse.
halfSpread = (tick / 2.0) / close
roundTrip  = (feeBuy + feeSell + feeTax) / 100.0 + 2.0 * halfSpread

// ---------------------------------------------------- the Hull ribbon [DRAWN]
// The lengths are derived at the top level rather than inside a function on
// purpose: ta.wma and ta.ema want a SIMPLE int length, and a length that has
// passed through a user function is a series int, which does not compile.
hSlow = hullLen
hHalf = math.max(1, int(hullLen / 2))
hRoot = math.max(1, int(math.round(math.sqrt(hullLen))))
fSlow = math.max(4, int(hullLen / 3))
fHalf = math.max(1, int(fSlow / 2))
fRoot = math.max(1, int(math.round(math.sqrt(fSlow))))

// Every one of these is evaluated on every bar. A ta.* call reached only on
// some bars silently corrupts its own internal state.
hmaSlow  = ta.wma(2.0 * ta.wma(close, hHalf) - ta.wma(close, hSlow), hRoot)
ehmaSlow = ta.ema(2.0 * ta.ema(close, hHalf) - ta.ema(close, hSlow), hRoot)
hmaFast  = ta.wma(2.0 * ta.wma(close, fHalf) - ta.wma(close, fSlow), fRoot)
ehmaFast = ta.ema(2.0 * ta.ema(close, fHalf) - ta.ema(close, fSlow), fRoot)

// ---------------------------------------- [MEASURED] H40, the flip price ----
//  THE PRICE AT WHICH THE RIBBON TURNS RED TOMORROW, in closed form. The Hull
//  average is LINEAR in the next close, so there is exactly one price x* at
//  which tomorrow's HMA equals today's; above it the ribbon stays green, below
//  it turns red. With m = n/2, s = round(sqrt(n)), W_k = k(k+1)/2:
//      WMA(p,k)_{t+1} = (k*x + C_k)/W_k,   C_k = W_{k-1} * WMA(p,k-1)_t
//      d_{t+1} = 2*WMA(p,m)_{t+1} - WMA(p,n)_{t+1} = b*x + a
//      x*      = (HMA_t * W_s - E - s*a) / (s*b),  E = W_{s-1}*WMA(d,s-1)_t
//  Verified against a brute-force recomputation to 1e-14. This is ARITHMETIC,
//  not a forecast: it says where the flip happens, never when.
//
//  AND IT IS A WIDE STOP, WHICH IS THE POINT OF PRINTING IT. Measured on every
//  bar where the hull55 ribbon is green, across 891 names: the level sits
//  13.5% below the close at the MEDIAN, 29.8% at the lower quartile and 75.8%
//  in the worst twentieth. Anyone treating "stop where the Hull turns" as a
//  tight stop is wrong by an order of magnitude, and the panel says so.
//
//  H40 also ran it against the alternatives, same entry, only the stop
//  differing, 891 names, net of 56 bps, ranked on compounded CAGR:
//      trail -25% from peak   +1.73%      hull55 flip price      -0.15%
//      fixed -20% from entry  +1.47%      confirmed support      -1.27%
//      hull55 flip + 1 bar    +1.01%      close under EMA50      -1.81%
//      trail -15% from peak   +0.57%      close under EMA34      -1.89%
//  The Hull flip beats support and both EMA stops and loses to a plain wide
//  percentage trail. NONE of the thirteen beat buy-and-hold (+8.8% to +11.6%).
zWm = hHalf * (hHalf + 1) / 2.0
zWn = hSlow * (hSlow + 1) / 2.0
zWs = hRoot * (hRoot + 1) / 2.0
zb  = 2.0 * hHalf / zWm - hSlow / zWn
zCm = (hHalf - 1) * hHalf / 2.0 * ta.wma(close, math.max(1, hHalf - 1))
zCn = (hSlow - 1) * hSlow / 2.0 * ta.wma(close, math.max(1, hSlow - 1))
za  = 2.0 * zCm / zWm - zCn / zWn
zd  = 2.0 * ta.wma(close, hHalf) - ta.wma(close, hSlow)
zE  = (hRoot - 1) * hRoot / 2.0 * ta.wma(zd, math.max(1, hRoot - 1))
//  The derivation is the WMA Hull only; in EHMA mode it does not apply and the
//  panel says n/a rather than printing a number from the wrong formula.
flipPx = hullMode == "EHMA" ? na
     : (hmaSlow * zWs - zE - hRoot * za) / (hRoot * zb)

hull   = hullMode == "EHMA" ? ehmaSlow : hmaSlow
hFast  = hullMode == "EHMA" ? ehmaFast : hmaFast
hull2  = hull[2]
hullUp = hull > hull2

pH1 = plot(showHull ? hull  : na, "Hull", hullUp ? color.new(color.lime, 20)
           : color.new(color.red, 20), 2)
pH2 = plot(showHull ? hull2 : na, "Hull offset", color.new(color.gray, 90), 1)
plot(showHull and hullUp ? flipPx : na, "flip price (ribbon turns red below)",
     color.new(color.orange, 25), 1, plot.style_linebr)
fill(pH1, pH2, color = hullUp ? color.new(color.lime, 80)
     : color.new(color.red, 80), title = "Hull ribbon")

// ------------------------------------------ [MEASURED] H30, the EMA stack ---
// Corrected constants. H30 published +0.0218 for the stacked state against a
// base of +0.0021; both were artefacts of computing the forward return on a
// date x ticker PIVOT, so the 60-bar step ran over the panel's union index
// instead of the name's own bars. Recomputed within each ticker:
//
//   state                       n         mean log   early     late   vs base
//   all eligible bars (base)    611,023   -0.0140   +0.0042  -0.0295     --
//   price>50>100>200            191,927   +0.0127   +0.0249  -0.0019   +267bp
//   ordered, price below         88,333   -0.0197   +0.0000  -0.0368    -57bp
//   not aligned                 330,763   -0.0279   -0.0104  -0.0402   -139bp
//
// The stack beats the base by +207bp early and +276bp late — positive in both
// halves RELATIVE TO THE BASE, which is the comparison that matters. It does
// NOT compound positively on its own: late-half absolute is -0.0019, flat.
emaS1 = ta.ema(close, emaSig)
emaF  = ta.ema(close, emaFast)
emaM  = ta.ema(close, emaMid)
emaSl = ta.ema(close, emaSlow)

stackFull = close > emaF and emaF > emaM and emaM > emaSl
stackOrd  = emaF > emaM and emaM > emaSl
stackScore = (close > emaF ? 1 : 0) + (emaF > emaM ? 1 : 0) + (emaM > emaSl ? 1 : 0)
stackLog = stackFull ? 0.0127 : stackOrd ? -0.0197 : -0.0279
stackLbl = stackFull ? "price>F>M>S (best)"
           : stackOrd ? "ordered, price below" : "not aligned"

plot(showEma ? emaS1 : na, "EMA signal", color.new(color.yellow, 20), 2)
plot(showEma ? emaF  : na, "EMA fast",   color.new(color.aqua, 40), 1)
plot(showEma ? emaM  : na, "EMA mid",    color.new(color.orange, 40), 1)
plot(showEma ? emaSl : na, "EMA slow",   color.new(color.fuchsia, 40), 2)
stackTint = stackFull ? color.new(color.green, 93)
             : stackOrd ? color.new(color.olive, 96) : na
bgcolor(showEma and tintStack ? stackTint : na, title = "stack")

// ------------------------------------------------------------- flip labels --
rawSig = sigSrc == "EMA34 break"      ? close > emaS1
         : sigSrc == "EMA stack"      ? stackFull
         : sigSrc == "Hull slope"     ? hullUp
         : sigSrc == "Dual Hull cross" ? hFast > hull : false
//  H37, measured on 47,002 confirmed swing highs. `giveBack` is the median
//  share of the peak already surrendered by the time the flip fires — the
//  number nobody quotes and the one that decides whether to act on it.
detF1 = sigSrc == "EMA34 break" ? 0.692 : sigSrc == "EMA stack" ? 0.445
         : sigSrc == "Hull slope" ? 0.683
         : sigSrc == "Dual Hull cross" ? 0.640 : na
detNull = sigSrc == "EMA34 break" ? 0.554 : sigSrc == "EMA stack" ? 0.396
         : sigSrc == "Hull slope" ? 0.472
         : sigSrc == "Dual Hull cross" ? 0.479 : na
giveBack = sigSrc == "EMA34 break" ? 0.109 : sigSrc == "EMA stack" ? 0.125
         : sigSrc == "Hull slope" ? 0.118
         : sigSrc == "Dual Hull cross" ? 0.105 : na
sigOn  = sigSrc != "None" and rawSig
buyFlip  = sigOn and not sigOn[1]
sellFlip = sigSrc != "None" and not rawSig and rawSig[1]

if buyFlip
    label.new(bar_index, low, "BUY", style = label.style_label_up,
              color = color.new(color.green, 10), textcolor = color.white,
              size = size.tiny)
if sellFlip
    label.new(bar_index, high, "SELL", style = label.style_label_down,
              color = color.new(color.red, 10), textcolor = color.white,
              size = size.tiny)

alertcondition(buyFlip,  "IDX Suite flip up",
     "{{ticker}}: selected state turned ON. Measured: no flip rule in this " +
     "family compounds; the dual Hull cross is the worst of them. Context only.")
alertcondition(sellFlip, "IDX Suite flip down",
     "{{ticker}}: selected state turned OFF. Context only, not a signal.")

// ============ [MEASURED] H32 — the price x time cone, as two fitted laws ====
//  Fitted to 180 measured cells (10 volatility deciles x 9 target levels x
//  trend state) over 623,126 eligible entries. d = |log(target/entry)|,
//  sigma = vol60, and the terms are [1, log d, (log d)^2, log sigma,
//  log d * log sigma] (+ stack for the probability).
//
//    log(sessions to target)                       R2     median  p90 error
//      q1      3.4462 +1.5154 -0.1484 -0.3646 +0.2492   0.981   7.3%   25.2%
//      median  4.2905 +1.2640 -0.1530 -0.2359 +0.2380   0.984   6.1%   17.2%
//      q3      5.0526 +0.9246 -0.1383 -0.0827 +0.2134   0.985   4.6%   12.4%
//
//    logit P(touch within 252)                            median  p90 error
//      up      1.3567 -1.1390 -0.3009 +1.1850 +0.3405 +0.1750  1.71pp  4.40pp
//      down    1.5117 -1.3308 -0.3158 +1.0515 +0.2545 -0.3388  1.75pp  4.03pp
//
//  THE CURVED TERMS ARE NOT DECORATION. The first fit was linear in log d and
//  it under-predicted P(+20%) by ELEVEN probability points — at the exact
//  target this panel ships as its default. Over a range from +5% to 2x the
//  logit bends, and a straight line sags through the middle, which is where a
//  user sets the dial. Check the fit AT the default before shipping it.
//
//  THE STACK COEFFICIENTS ARE THE FINDING. In odds terms a confirmed uptrend
//  multiplies the upside by 1.19 and the downside by 0.71 — nearly twice the
//  effect on the side nobody puts in the headline. A trend filter is mostly a
//  RISK filter.
//
//  AND THE SHAPE IS NOT DIFFUSION. A driftless random walk reaches a log
//  barrier d with per-bar sd sigma in a time scaling as (d/sigma)^2. This does
//  not, because the series trends, its volatility clusters, and the sample
//  CONDITIONS ON TOUCHING WITHIN 252 SESSIONS. That censoring is why the upper
//  quartile flattens with distance far faster than the lower one: the top of
//  the date band is partly the horizon and not the market. Nothing here
//  extrapolates past a year.
f_sessions(float d, float sig, float a, float b, float c, float e, float f) =>
    ld = math.log(d)
    ls = math.log(sig)
    math.exp(a + b * ld + c * ld * ld + e * ls + f * ld * ls)
f_ptouch(float d, float sig, bool up, bool stk) =>
    //  The coefficients are picked first and the arithmetic written once. A
    //  two-branch ternary spanning four lines is legal Pine and is a bad place
    //  to hide a sign error in a number nobody can check by eye.
    ld = math.log(d)
    ls = math.log(sig)
    ca = up ?  1.3567 :  1.5117
    cb = up ? -1.1390 : -1.3308
    cc = up ? -0.3009 : -0.3158
    ce = up ?  1.1850 :  1.0515
    cf = up ?  0.3405 :  0.2545
    cs = up ?  0.1750 : -0.3388
    z = ca + cb * ld + cc * ld * ld + ce * ls + cf * ld * ls + (stk ? cs : 0.0)
    1.0 / (1.0 + math.exp(-z))

// The fit's own domain. Outside it the laws are extrapolation, so the panel is
// made to say so rather than printing a confident number off the end of a line.
dRaw   = math.log(1.0 + tgtPct / 100.0)
sigOk  = not na(vol60) and vol60 > 0.0
sigUse = sigOk ? math.max(0.0117, math.min(0.0623, vol60)) : na
outOfDomain = sigOk and (vol60 < 0.0117 or vol60 > 0.0623)
daily = timeframe.isdaily
projOk = showProj and daily and sigOk and dRaw > 0.0 and not na(hi252)

sQ1  = projOk ? math.round(f_sessions(dRaw, sigUse, 3.4462, 1.5154,
                                      -0.1484, -0.3646, 0.2492)) : na
sMed = projOk ? math.round(f_sessions(dRaw, sigUse, 4.2905, 1.2640,
                                      -0.1530, -0.2359, 0.2380)) : na
sQ3  = projOk ? math.round(f_sessions(dRaw, sigUse, 5.0526, 0.9246,
                                      -0.1383, -0.0827, 0.2134)) : na
pUp  = projOk ? f_ptouch(dRaw, sigUse, true,  stackFull) : na
pDn  = projOk ? f_ptouch(dRaw, sigUse, false, stackFull) : na

tgtUp = close * (1.0 + tgtPct / 100.0)
tgtDn = close * (1.0 - tgtPct / 100.0)

// A trading session is not a calendar day. 252 sessions a year is 1.448
// calendar days each, which is what turns a session count into the DATE the
// request asked for. It is an average and holidays make it approximate — hence
// a band, and hence no attempt at a single day.
f_date(float sessions) =>
    na(sessions) ? "n/a" :
     str.format_time(time + int(sessions * 1.448 * 86400000), "d MMM yy",
                     "Asia/Jakarta")

var box  bxUp = na
var box  bxDn = na
var line lnUp = na
var line lnDn = na
if projOk and barstate.islast
    //  One statement per line. Pine has no comma operator, and chaining calls
    //  with commas is a compile error this file has made before.
    box.delete(bxUp)
    box.delete(bxDn)
    line.delete(lnUp)
    line.delete(lnDn)
    l = bar_index + int(math.min(sQ1, 400))
    r = bar_index + int(math.min(sQ3, 480))
    m = bar_index + int(math.min(sMed, 440))
    h = close * 0.006                                   // a readable thickness
    txUp = str.tostring(math.round(pUp * 100)) + "%  " +
      str.tostring(tgtUp, format.mintick)
    bxUp := box.new(l, tgtUp + h, r, tgtUp - h,
      border_color = color.new(color.lime, 30),
      bgcolor = color.new(color.lime, 80),
      text = txUp, text_color = color.lime, text_size = size.tiny)
    lnUp := line.new(bar_index, tgtUp, m, tgtUp,
                     color = color.new(color.lime, 40), style = line.style_dotted)
    if showDown
        txDn = str.tostring(math.round(pDn * 100)) + "%  " +
          str.tostring(tgtDn, format.mintick)
        bxDn := box.new(l, tgtDn + h, r, tgtDn - h,
          border_color = color.new(color.red, 30),
          bgcolor = color.new(color.red, 85),
          text = txDn, text_color = color.red, text_size = size.tiny)
        lnDn := line.new(bar_index, tgtDn, m, tgtDn,
                         color = color.new(color.red, 40), style = line.style_dotted)

// =============== [MEASURED] H34 — swing levels yes, Fibonacci no ============
//  A ZigZag swing high is a REAL barrier and the Fibonacci ratios are not, and
//  both halves of that were measured the same way: the same construction
//  against the wrong level.
//
//  SUPPORT / RESISTANCE (H34b). Event = first close above a confirmed prior
//  swing high; placebo = the same event against that high displaced +/-7%.
//  23,235 events, distance-adjusted, ticker-clustered 95% CI:
//      false break (closes back under within 20 bars)  -6.95pp [-8.26, -5.70]
//      follow-through (+5% within 20 bars)             +4.46pp [+3.08, +5.58]
//      forward 20-session return                       +1.00% [+0.58, +1.37]
//  All three replicate in both halves — the only level result in this research
//  that does. NOTE WHAT IT IS NOT: the false-break rate at the TRUE level is
//  still 66.4%. Two breakouts in three close back under within a month. The
//  finding is that a real level beats a fake one, not that breakouts work.
//
//  FIBONACCI (H34a). 280,228 (leg, ratio) touches on a CONTINUOUS grid from
//  0.15 to 0.95 in steps of 0.025, because the only fair question is whether
//  0.618 stands out from 0.60 and 0.65 — neighbours matched on depth that are
//  not Fibonacci numbers. P(the leg high is regained within 60 bars):
//      0.475 -> 0.3631      0.500 -> 0.3611      0.525 -> 0.3571
//  The curve is monotone from 0.3964 at r=0.15 to 0.2911 at r=0.95 with no
//  bump anywhere. Against 2,000 draws of five random non-Fibonacci nodes:
//  z = +0.77 (p 0.45), +0.68, +0.41, -0.95. NOTHING.
//  They are drawn because they were asked for. They measured nothing.
gR = "Levels (H34)"
showSR   = input.bool(true, "Draw confirmed swing support/resistance", group = gR)
zzPct    = input.float(10.0, "Swing threshold %", minval = 2.0, maxval = 40.0,
     step = 0.5, group = gR,
     tooltip = "A swing high is confirmed only once price has fallen this far " +
               "from it. THAT LAG IS THE POINT: a pivot drawn at the bar it " +
               "occurred uses information that did not exist until the " +
               "reversal, which is the look-ahead trap in every ZigZag study.")
showFib  = input.bool(false, "Draw Fibonacci retracements", group = gR,
     tooltip = "OFF by default because they measured nothing. On a continuous " +
               "grid of 33 retracement depths the bounce-rate curve is " +
               "perfectly smooth and the five Fibonacci ratios sit exactly on " +
               "it: z = +0.77, +0.68, +0.41, -0.95, every p above 0.35. " +
               "0.500 reads 0.3611 between 0.475's 0.3631 and 0.525's 0.3571.")

// The ZigZag, carried forward bar by bar. Confirmation only — `lastHi` and
// `lastLo` are levels that were knowable at the time, never hindsight pivots.
zzK = zzPct / 100.0
var float curHi = na
var float curLo = na
var int   zzDir = 0
var float lastHi = na
var float lastLo = na
//  EVERY confirmed pivot is kept, not just the last one. RESISTANCE IS THE
//  NEAREST CONFIRMED HIGH ABOVE PRICE, and after a deep fall followed by a
//  lower high the most recent high can sit BELOW price — at which point a
//  last-pivot-only version prints "none above, at new highs" for a name a
//  quarter off its 52-week peak. The panel contradicting its own drawdown row
//  is what exposed that; a chart that only looks at the last pivot cannot see
//  the level everyone else is watching.
var array<float> hiArr = array.new<float>()
var array<float> loArr = array.new<float>()
f_push(array<float> a, float v) =>
    array.push(a, v)
    if array.size(a) > 80
        array.shift(a)
f_above(array<float> a, float px) =>
    best = float(na)
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            best := v > px and (na(best) or v < best) ? v : best
    best
f_below(array<float> a, float px) =>
    best = float(na)
    if array.size(a) > 0
        for i = 0 to array.size(a) - 1
            v = array.get(a, i)
            best := v < px and (na(best) or v > best) ? v : best
    best
//  ONLY THE EXTREME OF THE LEG IN PROGRESS IS TRACKED. A first version updated
//  both on every bar, so the running high kept ratcheting through a down leg
//  and the next confirmed high could never be lower than the last -- a swing
//  detector that can only find higher highs, which would have quietly turned
//  every downtrend into "no resistance above".
if zzDir > 0
    curHi := math.max(nz(curHi, close), close)
else if zzDir < 0
    curLo := math.min(nz(curLo, close), close)
else
    curHi := math.max(nz(curHi, close), close)
    curLo := math.min(nz(curLo, close), close)

if zzDir >= 0 and not na(curHi) and close <= curHi * (1.0 - zzK)
    lastHi := curHi
    f_push(hiArr, curHi)
    zzDir := -1
    curLo := close
else if zzDir <= 0 and not na(curLo) and close >= curLo * (1.0 + zzK)
    lastLo := curLo
    f_push(loArr, curLo)
    zzDir := 1
    curHi := close

// The target is the nearest confirmed level ABOVE, the stop the nearest
// confirmed level BELOW. When price is making new highs there is no confirmed
// resistance above it, and the panel says so rather than inventing one.
resLvl = f_above(hiArr, close)
supLvl = f_below(loArr, close)

dUp = na(resLvl) ? na : math.log(resLvl / close)
dDn = na(supLvl) ? na : math.log(close / supLvl)
pRes = projOk and not na(dUp) and dUp > 0 ? f_ptouch(dUp, sigUse, true, stackFull) : na
pSup = projOk and not na(dDn) and dDn > 0 ? f_ptouch(dDn, sigUse, false, stackFull) : na

// P(the target is reached BEFORE the stop | one of them is), which is the
// question a bracket actually asks and is not answered by the two touch
// probabilities separately. Fitted on 300 (tp, sl, volatility-decile) cells:
// median error 1.26pp, p90 3.67pp. The volatility term is almost exactly zero
// (-0.0225) — WHICH BARRIER ARRIVES FIRST IS A RATIO OF DISTANCES, not a
// question about how fast the name moves. Volatility speeds up both equally.
f_race(float dup, float ddn, float sig) =>
    z = 0.0588 - 0.7635 * math.log(dup) + 0.8160 * math.log(ddn) -
     0.0225 * math.log(sig)
    1.0 / (1.0 + math.exp(-z))
pFirst = projOk and not na(dUp) and not na(dDn) and dUp > 0 and dDn > 0
     ? f_race(math.exp(dUp) - 1.0, 1.0 - math.exp(-dDn), sigUse) : na

// Fibonacci of the last completed leg, drawn only.
fibLo = math.min(nz(lastLo, close), nz(lastHi, close))
fibHi = math.max(nz(lastLo, close), nz(lastHi, close))
fibSpan = fibHi - fibLo

// DYNAMIC ACROSS ALL HISTORY, NOT JUST THE RIGHT EDGE. Plotting the levels as
// a stepped series means every past bar shows the level that was KNOWN THEN,
// which is what makes the chart auditable by eye: scroll back and the line is
// where it would have been, because it is built from confirmed pivots only and
// never repaints. The right-edge lines below are the same numbers, drawn long
// enough to read a price off.
plot(showSR ? resLvl : na, "resistance (dynamic)",
     color.new(color.red, 45), 1, plot.style_linebr)
plot(showSR ? supLvl : na, "support (dynamic)",
     color.new(color.lime, 45), 1, plot.style_linebr)
plot(showFib and fibSpan > 0 ? fibHi - 0.500 * fibSpan : na, "fib 50 (dynamic)",
     color.new(color.gray, 70), 1, plot.style_linebr)

var line lnRes = na
var line lnSup = na
var line f236 = na
var line f382 = na
var line f500 = na
var line f618 = na
var line f786 = na
f_level(line old, float y, color c, string st) =>
    line.delete(old)
    na(y) ? na : line.new(bar_index - 120, y, bar_index + 30, y, color = c,
      style = st, width = 1, extend = extend.none)

if barstate.islast
    lnRes := f_level(lnRes, showSR ? resLvl : na, color.new(color.red, 20),
      line.style_solid)
    lnSup := f_level(lnSup, showSR ? supLvl : na, color.new(color.lime, 20),
      line.style_solid)
    okFib = showFib and fibSpan > 0
    f236 := f_level(f236, okFib ? fibHi - 0.236 * fibSpan : na,
      color.new(color.gray, 55), line.style_dotted)
    f382 := f_level(f382, okFib ? fibHi - 0.382 * fibSpan : na,
      color.new(color.gray, 55), line.style_dotted)
    f500 := f_level(f500, okFib ? fibHi - 0.500 * fibSpan : na,
      color.new(color.gray, 55), line.style_dotted)
    f618 := f_level(f618, okFib ? fibHi - 0.618 * fibSpan : na,
      color.new(color.gray, 55), line.style_dotted)
    f786 := f_level(f786, okFib ? fibHi - 0.786 * fibSpan : na,
      color.new(color.gray, 55), line.style_dotted)

// ------------------------------------------------------------- the panel ----
f_pos() =>
    panelPos == "Top right"     ? position.top_right    :
     panelPos == "Top left"     ? position.top_left     :
     panelPos == "Bottom right" ? position.bottom_right : position.bottom_left
f_size() =>
    txtSize == "Tiny" ? size.tiny : txtSize == "Small" ? size.small : size.normal

// THEME-AWARE, BECAUSE color.white IS INVISIBLE ON A WHITE CHART. The first
// version in a user's hands was run in TradingView light mode and every row
// coloured color.white vanished: annualised vol, % of 52-week high, turnover,
// all three projection dates, board, tick and round trip were simply blank,
// while the orange and lime rows beside them showed fine. A panel that
// silently drops half its rows depending on a display setting is worse than
// one that fails loudly. chart.fg_color contrasts with whatever background
// the user has, and the cells now paint their own background so the price
// lines cannot bleed through the text either.
fgCol = chart.fg_color
cellBg = color.new(chart.bg_color, 12)
headBg = color.new(chart.fg_color, 82)

var table P = table.new(f_pos(), 2, 43, border_width = 1)

f_row(int r, string k, string v, color c) =>
    table.cell(P, 0, r, k, text_size = f_size(), text_color = fgCol,
               bgcolor = cellBg, text_halign = text.align_left)
    table.cell(P, 1, r, v, text_size = f_size(), text_color = c,
               bgcolor = cellBg, text_halign = text.align_right)
f_head(int r, string t) =>
    table.cell(P, 0, r, t, text_size = f_size(), text_color = fgCol,
               bgcolor = headBg, text_halign = text.align_left)
    table.cell(P, 1, r, "", text_size = f_size(), bgcolor = headBg)

if showPanel and barstate.islast
    table.clear(P, 0, 0, 1, 40)

    f_head(0, "STATE")
    f_row(1, "annualised vol (60b)",
          na(volAnn) ? "n/a" : str.tostring(volAnn * 100, "#.0") + "%", fgCol)
    f_row(2, "IDX volatility decile",
          na(vol60) ? "n/a" : str.tostring(volDecile(vol60)) + " of 10",
          na(vol60) ? color.gray : volDecile(vol60) >= 9 ? color.orange : fgCol)
    f_row(3, "% of 52-week high",
          na(hi52) ? "n/a" : str.tostring(hi52 * 100, "#.1") + "%",
          not na(hi52) and hi52 >= 0.90 ? color.lime : fgCol)
    f_row(4, "drawdown from peak",
          na(ddPk) ? "n/a" : str.tostring(ddPk * 100, "#.1") + "%",
          not na(ddPk) and ddPk < -0.20 ? color.orange : fgCol)
    f_row(5, "turnover (20b median)",
          "Rp " + str.tostring(rpDay / 1e9, "#.##") + "bn", fgCol)

    f_head(6, "TREND  [H30, corrected]")
    f_row(7, "EMA stack", stackLbl + "  " + str.tostring(stackScore) + "/3",
          stackFull ? color.lime : stackOrd ? color.olive : color.gray)
    f_row(8, "60b fwd mean log, this state",
          str.tostring(stackLog, "#.####") + "  (base -0.0140)",
          stackLog > 0.0 ? color.lime : color.gray)
    f_row(9, "Hull " + str.tostring(hullLen) + " slope", hullUp ? "rising" : "falling",
          hullUp ? color.lime : color.red)
    f_row(10, hullUp ? "  turns RED below" : "  turns GREEN above",
          na(flipPx) ? "n/a (EHMA)" : str.tostring(flipPx, format.mintick) +
           "   " + str.tostring(100 * (flipPx / close - 1.0), "#.1") + "%",
          na(flipPx) ? color.gray : hullUp ? color.orange : color.lime)

    f_head(11, "PROJECTION  [H32, in-sample, 1y]")
    f_row(12, "target  +" + str.tostring(tgtPct, "#.#") + "%",
          projOk ? str.tostring(tgtUp, format.mintick) : "n/a",
          projOk ? color.lime : color.gray)
    f_row(13, "P(touch it within a year)",
          projOk ? str.tostring(pUp * 100, "#.0") + "%" : "n/a",
          projOk ? color.lime : color.gray)
    f_row(14, "  earliest quartile", projOk ? f_date(sQ1) + "  (" +
          str.tostring(sQ1, "#") + "b)" : "n/a", fgCol)
    f_row(15, "  median", projOk ? f_date(sMed) + "  (" +
          str.tostring(sMed, "#") + "b)" : "n/a", fgCol)
    f_row(16, "  latest quartile", projOk ? f_date(sQ3) + "  (" +
          str.tostring(sQ3, "#") + "b)" : "n/a", fgCol)
    f_row(17, "mirror  -" + str.tostring(tgtPct, "#.#") + "%",
          projOk ? str.tostring(tgtDn, format.mintick) + "   " +
                   str.tostring(pDn * 100, "#.0") + "%" : "n/a",
          projOk ? color.red : color.gray)
    oddsCol = not projOk ? color.gray : pUp / pDn >= 1.2 ? color.lime
               : pUp / pDn < 1.0 ? color.red : fgCol
    f_row(18, "up / down odds",
          projOk ? str.tostring(pUp / pDn, "#.00") + "x" : "n/a", oddsCol)
    f_row(19, "caveat",
          not daily ? "SET CHART TO DAILY"
           : outOfDomain ? "vol outside fitted range"
           : not showProj ? "projection off" : "in-sample; band, not a date",
          not daily or outOfDomain ? color.orange : color.gray)

    f_head(20, "TARGET / STOP  [H34, swing levels]")
    f_row(21, "resistance (target)",
          na(resLvl) ? "none above - at new highs"
           : str.tostring(resLvl, format.mintick) + "   +" +
             str.tostring(100 * (resLvl / close - 1.0), "#.1") + "%",
          na(resLvl) ? color.gray : color.red)
    f_row(22, "  P(touch it within a year)",
          na(pRes) ? "n/a" : str.tostring(pRes * 100, "#.0") + "%",
          na(pRes) ? color.gray : fgCol)
    f_row(23, "support (stop)",
          na(supLvl) ? "none below - at new lows"
           : str.tostring(supLvl, format.mintick) + "   -" +
             str.tostring(100 * (1.0 - supLvl / close), "#.1") + "%",
          na(supLvl) ? color.gray : color.lime)
    f_row(24, "  P(touch it within a year)",
          na(pSup) ? "n/a" : str.tostring(pSup * 100, "#.0") + "%",
          na(pSup) ? color.gray : fgCol)
    f_row(25, "P(target first | one is hit)",
          na(pFirst) ? "n/a" : str.tostring(pFirst * 100, "#.0") + "%",
          na(pFirst) ? color.gray : pFirst >= 0.5 ? color.lime : color.orange)
    f_row(26, "bracket verdict",
          "0 of 30 beat hold in both halves", color.orange)
    f_row(27, "fibonacci", showFib ? "drawn - measured nothing" : "off",
          color.gray)

    f_head(28, "HOW ACCURATE  [H36/H37, measured]")
    f_row(29, "flip catches the top (F1)",
          na(detF1) ? "n/a" : str.tostring(detF1, "#.000") + "  vs null " +
           str.tostring(detNull, "#.000"),
          na(detF1) ? color.gray : detF1 > detNull ? color.lime : color.red)
    f_row(30, "  peak already given back",
          na(giveBack) ? "n/a" : str.tostring(giveBack * 100, "#.1") + "%",
          color.orange)
    f_row(31, "P(touch) skill vs base rate", "+0.013 out-of-sample", fgCol)
    f_row(32, "date band coverage", "0.500 measured / 0.50 claimed", color.lime)

    f_head(33, "IDX MECHANICS  [exact]")
    f_row(34, "board", isThin ? "THIN +/-10%" : "main",
          isThin ? color.orange : fgCol)
    f_row(35, "tick / max step", "Rp " + str.tostring(tick, "#") + " / Rp " +
          str.tostring(maxStep, "#"), fgCol)
    f_row(36, "ARA tomorrow", "Rp " + str.tostring(araLvl, "#") + "  (+" +
          str.tostring(araPct * 100, "#") + "%)", color.lime)
    f_row(37, "ARB tomorrow", "Rp " + str.tostring(arbLvl, "#") + "  (-" +
          str.tostring(arbPct * 100, "#") + "%)", color.red)
    f_row(38, "round trip (floor)", str.tostring(roundTrip * 100, "#.2") + "%",
          roundTrip > 0.015 ? color.orange : fgCol)
    f_row(39, "flip labels",
          sigSrc == "None" ? "off" : sigSrc + " - none compound",
          color.gray)
    f_row(40, "H44 tradeable universe",
          tradeable ? "YES - indicator edges tested here are ~ZERO"
           : "NO - thin/cheap; edges here are non-synchronous pricing",
          tradeable ? color.lime : color.red)
    //  H47/H48 sit here rather than in a memo because this is where the
    //  decision gets made. The first row is the one that stops a specific
    //  mistake: bolting a sell-off detector onto this exit makes the give-back
    //  WORSE than leaving at random at the same speed, in 11 cells out of 11.
    f_row(41, "sell-off exits [H47]",
          "11 of 11 give back MORE than random of same speed", color.orange)
    f_row(42, "ribbon vs holding [H48]",
          "-5.5%/yr on 233 liquid names, both halves", color.orange)
