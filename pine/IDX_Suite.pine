//@version=6
// =============================================================================
//  IDX CONTEXT  —  an Indonesian-market state panel with measured conditionals
// =============================================================================
//
//  WHAT THIS IS
//  ------------
//  A general-purpose read on any IDX chart. It answers "where does this name
//  stand, what does that state historically imply, and what does it cost to
//  act" — rather than telling you to buy or sell. It has four layers and they
//  are NOT equally trustworthy, so the panel labels each one:
//
//    [EXACT]    IDX mechanics — tick size, auto-rejection levels, max price
//               step, round-trip cost. Arithmetic from the published rules.
//               These are simply correct.
//    [STATE]    Where the name is — volatility, distance from its 52-week
//               high, drawdown from peak. Measurement, no inference.
//    [MEASURED] What that state implied historically, from 31,394 name-years
//               of IDX data, 2000-2024, pre-holdout. In-sample, one-year
//               horizon, and the odds are frequencies, not forecasts.
//    [OPTIONAL] One screen, off by default.
//
//  THE HONEST HEADER, because it belongs on the chart and not in a footnote:
//    * Every probability here is IN-SAMPLE. The out-of-sample holdout was
//      spent once and is gone.
//    * Every probability is a ONE-YEAR (252-session) figure. The same family
//      of rules INVERTS below three years and again above five, so a number
//      quoted without its horizon is a wrong number.
//    * NOTHING here forecasts magnitude. The 2x line is the level the
//      probability was measured against — never a target.
//    * Nine index-timing rules were tested over two independent halves and
//      ALL EIGHTEEN cells lost to buy-and-hold. This indicator does not time.
//
//  WHY THE THRESHOLDS ARE ABSOLUTE AND NOT CROSS-SECTIONAL
//  --------------------------------------------------------
//  The research ranks every IDX name against every other on the same day. A
//  chart sees one symbol. The obvious fix — pull 36 reference symbols with
//  request.security() and rank against them — was built and BACKTESTED, and
//  it lost: skew 1.86 and 53% of the true rule's picks, against 2.01 and 72%
//  for plain absolute thresholds. A percentile ranked against ~24 live names
//  is noisier than a fixed threshold is stale. So there are zero
//  request.security() calls here: it works on any IDX chart, needs no
//  reference basket, and measures better.
//
//  MATCHING THE RESEARCH EXACTLY
//  ------------------------------
//  The thresholds below are thresholds on specific quantities, so the
//  quantities must be computed identically or they mean nothing:
//    vol60 = SAMPLE stdev (ddof=1) of simple daily returns over 60 bars,
//            NOT annualised.  ta.stdev(..., biased=false) is the sample form;
//            Pine's default is the population form and would read ~0.8% low.
//    hi52  = close / highest(close, 252).
//  The panel builds both on adjusted close where TradingView provides it.
//  Set the chart to "Adjust data for dividends" to match; the measured IDX
//  dividend is ~1.27%/yr, so leaving it off is a small, one-signed error.
//
//  Sources: hypotheses H13/H19/H22/H23/H26/H27 and reports/*.md in the
//  research repository. Every number below traces to one of them.
// =============================================================================

indicator("IDX Suite", "IDX Suite", overlay = true, max_labels_count = 100)

// ----------------------------------------------------------------- inputs --
gM = "Panel"
showPanel = input.bool(true,  "Show panel",                group = gM)
panelPos  = input.string("Top right", "Panel position",
     options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = gM)
txtSize   = input.string("Small", "Text size",
     options = ["Tiny", "Small", "Normal"], group = gM)

gC = "Costs (your actual broker schedule)"
feeBuy  = input.float(0.28, "Buy commission %",  minval = 0, step = 0.01, group = gC,
     tooltip = "Default is the Mandiri retail schedule the research uses: " +
               "0.28% buy, 0.18% sell, 0.10% sell tax = 0.56% round trip. " +
               "Change these to YOUR broker's numbers — every net figure " +
               "on the panel moves with them.")
feeSell = input.float(0.18, "Sell commission %", minval = 0, step = 0.01, group = gC)
feeTax  = input.float(0.10, "Sell tax %",        minval = 0, step = 0.01, group = gC)

gB = "IDX board"
boardIn = input.string("Auto", "Auto-rejection board",
     options = ["Auto", "Main", "Thin (Pemantauan Khusus / Akselerasi)"], group = gB,
     tooltip = "The thin board trades a FLAT +/-10% band; the main board is " +
               "+35/25/20% up against a flat -15% down. Using the main ladder " +
               "on a thin-board name allows moves that cannot happen — a real " +
               "bug in the research repo that affected 41 of 818 names. " +
               "Auto infers from the 6-month average price (IDX's own rule: " +
               "below Rp51 puts a name on the watchlist), which is a guess, " +
               "so override it if you know the board.")

gE = "EMA stack (H30, measured on IDX)"
showEma  = input.bool(true, "Show the EMA stack", group = gE)
emaFast  = input.int(50,  "Fast EMA",   minval = 2, group = gE)
emaMid   = input.int(100, "Mid EMA",    minval = 3, group = gE)
emaSlow  = input.int(200, "Slow EMA",   minval = 4, group = gE,
     tooltip = "50/100/200 is not here because it is conventional -- it was " +
               "GRIDDED on IDX. 36 (fast, mid, slow) combinations were scored " +
               "over 744 names and 5,879 pre-holdout sessions, and the state " +
               "price>50>100>200 came out best on mean LOG return, which is " +
               "the statistic that decides whether a thing compounds.")
tintStack = input.bool(true, "Tint the background by stack state", group = gE)

gS = "Optional screen"
showSig  = input.bool(false, "Show the strength+calm screen", group = gS,
     tooltip = "OFF by default. This is ONE screen out of many tested and it " +
               "is not a recommendation. See the panel for its measured odds " +
               "and, more importantly, for what it gives up.\n\n" +
               "DO NOT USE IT TO PICK BIG CAPS. Backtested on the " +
               "point-in-time top 50 by turnover (H29): it improves the " +
               "ratio (skew 1.54 -> 2.35, clears its null at z=+5.01) and " +
               "DESTROYS the return. Ten screen names a year returned +7.1% " +
               "CAGR against +8.9% for random draws from the same 50 and " +
               "+11.7% for the index -- it beat the index in 0 of 400 draws. " +
               "It cuts P(2x) from 11.4% to 6.3%: it buys the ratio by " +
               "giving up the upside, and on big caps that is fatal.")
sigHi    = input.float(0.9625, "Strength: close / 252-bar high >=", step = 0.0025, group = gS,
     tooltip = "0.9625 = within 3.75% of the 52-week high. This is the " +
               "absolute equivalent of the research's 90th-percentile cut, " +
               "measured as the median daily cut over 601,840 name-days.")
sigVol   = input.float(0.0257, "Calm: 60-bar return stdev <=", step = 0.0005, group = gS,
     tooltip = "0.0257 daily = 40.8% annualised. The absolute equivalent of " +
               "the 50th-percentile volatility cut.")

// ------------------------------------------------------------ [STATE] core --
// Simple daily returns on the chart's close. SAMPLE stdev to match pandas
// .std() (ddof=1); Pine's default biased=true is the population form.
ret1  = close / close[1] - 1.0
vol60 = ta.stdev(ret1, 60, false)
volAnn = vol60 * math.sqrt(252)

hi252 = ta.highest(close, 252)
hi52  = close / hi252                       // 1.0 = at the 52-week high
ddPk  = close / hi252 - 1.0                 // drawdown from the 252-bar peak

// Turnover proxy. TradingView gives volume in shares; Rp/day is close*volume.
// It is a proxy because the research uses a 20-day median of close*volume and
// has no VWAP either — the same approximation, stated rather than hidden.
rpDay = ta.median(close * volume, 20)

// Run age: sessions since the 252-bar high was last touched. Descriptive.
var int barsSinceHi = 0
barsSinceHi := close >= hi252 * 0.9999 ? 0 : nz(barsSinceHi[1]) + 1

// ------------------------------------------------------ [EXACT] IDX ladders --
// Fraksi harga, Kep-00023/BEI/04-2016, reaffirmed Kep-00003/BEI/04-2025.
tickOf(float p) =>
    p < 200 ? 1.0 : p < 500 ? 2.0 : p < 2000 ? 5.0 : p < 5000 ? 10.0 : 25.0

// Jenjang maksimum perubahan harga — the largest single step an order may move
// the price. A DIFFERENT constraint from the tick and from auto-rejection, and
// on an illiquid name it binds first.
maxStepOf(float p) =>
    p < 200 ? 10.0 : p < 500 ? 20.0 : p < 2000 ? 50.0 : p < 5000 ? 100.0 : 250.0

// Auto-rejection. The CEILING has never moved in the covered period; every
// change since 2020 has been to the floor. Current floor is a flat 15%
// (Kep-00003/BEI/04-2025, effective 2025-04-08) — asymmetric again.
araMain(float p) => p < 200 ? 0.35 : p < 5000 ? 0.25 : 0.20
arbMain(float p) => 0.15
// Thin board: a flat 10% both ways (below Rp10 it is an absolute Rp1 band).
araThin(float p) => 0.10
arbThin(float p) => 0.10

// ta.* functions must be evaluated on EVERY bar to keep their internal state
// correct. Putting ta.sma() inside a short-circuiting `or` can skip it on some
// bars and silently corrupt the average, so it is hoisted to its own line.
avg126 = ta.sma(close, 126)
isThin = boardIn == "Thin (Pemantauan Khusus / Akselerasi)" or
         (boardIn == "Auto" and not na(avg126) and avg126 < 51)

tick    = tickOf(close)
maxStep = maxStepOf(close)
araPct  = isThin ? araThin(close) : araMain(close)
arbPct  = isThin ? arbThin(close) : arbMain(close)

// Round the limit to the tick grid — IDX limits sit on tradeable prices, and
// every real IDX close is an exact multiple of that day's tick.
araLvl = math.floor(close * (1 + araPct) / tick) * tick
arbLvl = math.ceil (close * (1 - arbPct) / tick) * tick

// Cost floor. Half a tick is the OPTIMISTIC spread — it assumes a one-tick
// book, roughly right on a large cap and generous on a small one. So this is
// a floor, not an estimate, and the true cost is worse.
halfSpread = (tick / 2.0) / close
roundTrip  = (feeBuy + feeSell + feeTax) / 100.0 + 2.0 * halfSpread

// ------------------------------------------ [MEASURED] H30, the EMA stack ---
// GRIDDED ON IDX, NOT INHERITED FROM US FOLKLORE. 36 (fast, mid, slow)
// combinations over 744 names and 5,879 pre-holdout sessions, 60-session
// forward hold, scored on MEAN LOG return because that is what compounds.
//
//   UNCONDITIONAL, every eligible name-bar:  mean +3.88%, median +0.00%,
//   mean log +0.0021 -> +0.9%/yr. The mean is volatility drag in disguise and
//   this is the benchmark every row below is measured against.
//
//   state                n         mean log   early    late   both>base?
//   price > EMA100       253,136   +0.0159   +0.0308  +0.0009     no
//   50>100>200           205,790   +0.0142   +0.0270  +0.0014     no
//   13>34>100            195,393   +0.0197   +0.0331  +0.0063    YES
//   price>50>100>200     142,797   +0.0218   +0.0327  +0.0109    YES  <- best
//
// SO THE FULL STACK IS WHAT SURVIVES, and a single moving average does not:
// price>EMA100 alone and the bare 50>100>200 cross both collapse to the base
// rate in the recent half. Requiring price ABOVE the stack as well as the
// stack being ordered is what holds up in both eras.
//
// AND THE CROSS ITSELF IS NOT THE SIGNAL -- THE STATE IS.
// Entering on the bar the stack first aligns and holding 60 sessions gives a
// positive mean (+4.25% net for the best of 36) with a NEGATIVE median
// (-0.62%) and a sub-50% win rate, and it does NOT compound positively in
// both halves (mean log +0.0274 early, -0.0145 late). That is the same
// mean/median wedge that withdrew H17 and H18. So this plots the STATE and
// deliberately does not fire an entry alert on the crossover.
emaF = ta.ema(close, emaFast)
emaM = ta.ema(close, emaMid)
emaS = ta.ema(close, emaSlow)

stackFull = close > emaF and emaF > emaM and emaM > emaS
stackOrd  = emaF > emaM and emaM > emaS          // ordered but price below
stackScore = (close > emaF ? 1 : 0) + (emaF > emaM ? 1 : 0) +
             (emaM > emaS ? 1 : 0)

// The measured mean-log for the state the chart is in right now, and the base.
stackLog  = stackFull ? 0.0218 : stackOrd ? 0.0142 : 0.0021
stackLbl  = stackFull ? "price>F>M>S  (best)" :
            stackOrd  ? "ordered, price below" : "not aligned"

plot(showEma ? emaF : na, "EMA fast", color.new(color.aqua, 30), 1)
plot(showEma ? emaM : na, "EMA mid",  color.new(color.orange, 30), 1)
plot(showEma ? emaS : na, "EMA slow", color.new(color.fuchsia, 30), 2)
bgcolor(showEma and tintStack
        ? (stackFull ? color.new(color.green, 93)
           : stackOrd ? color.new(color.olive, 96) : na) : na,
        title = "stack state")

// ------------------------------------------- [MEASURED] the conditionals ----
// H26. Asymmetry by distance from the 52-week high, 1-year horizon, IDX
// 2000-2024 pre-holdout. skew = P(touch 2x) / P(end at or below half).
//   nearest the high (top decile)   P(2x) 13.6%  P(halve)  6.3%  skew 2.15
//   middle                          P(2x) 11.2%  P(halve)  7.4%  skew 1.53
//   furthest below (bottom decile)  P(2x) 15.1%  P(halve) 18.9%  skew 0.80
// The gradient is monotone and it is the opposite of the common intuition:
// FALLEN NAMES HALVE MORE OFTEN THAN THEY DOUBLE.
bucketName = hi52 >= 0.90 ? "near 52w high" : hi52 >= 0.60 ? "mid-range" : "far below high"
bucketUp   = hi52 >= 0.90 ? 0.136 : hi52 >= 0.60 ? 0.112 : 0.151
bucketDn   = hi52 >= 0.90 ? 0.063 : hi52 >= 0.60 ? 0.074 : 0.189
bucketSkew = bucketUp / bucketDn

// H19 recovery curve. P(a new 60-session high) GIVEN you are already X below
// the peak, from 243,977 armed liquid pre-holdout bars. It crosses one-half
// between -5% and -10%.
recoveryOdds(float dd) =>
    d = math.abs(dd) * 100.0
    d <=  5 ? 0.813 :
     d <= 10 ? 0.813 + (d -  5) / 5  * (0.561 - 0.813) :
     d <= 15 ? 0.561 + (d - 10) / 5  * (0.388 - 0.561) :
     d <= 20 ? 0.388 + (d - 15) / 5  * (0.271 - 0.388) :
     d <= 25 ? 0.271 + (d - 20) / 5  * (0.173 - 0.271) :
     d <= 30 ? 0.173 + (d - 25) / 5  * (0.113 - 0.173) :
     d <= 40 ? 0.113 + (d - 30) / 10 * (0.059 - 0.113) :
     d <= 60 ? 0.059 + (d - 40) / 20 * (0.008 - 0.059) : 0.008

ema50   = ta.ema(close, 50)
// H19c: being above the EMA50 in a SHALLOW drawdown is worth up to +22.4
// points of recovery probability (9 positive / 0 negative across depths). The
// help concentrates at -5 to -15% and decays to nothing past -20%. The
// stochastic cross tested 5 positive / 6 negative — noise — so it is not here.
emaBonus = close > ema50 and ddPk > -0.20 ? 0.224 * math.max(0.0, 1.0 + ddPk / 0.20) : 0.0
recOdds  = math.min(0.99, recoveryOdds(ddPk) + emaBonus)

// H23. P(touch 2x) by holding period, unscreened IDX. THE TILT INVERTS below
// three to five years — this row exists so the one-year number is never read
// as the whole story.
//   1y 9.5%   2y 18.9%   3y 27.0%   5y 39.0%   7.5y 46.7%   10y 55.5%

// -------------------------------------------- [OPTIONAL] the one screen -----
// H26 strength+calm, as measured with these absolute thresholds:
//   P(touch 2x in a year) 8.3%,  P(end at or below half) 4.1%,  skew 2.01
//   against an unscreened base of 12.1% / 9.0% / 1.33.
//   Clustered permutation null over whole (ticker, year) blocks, 5,000 draws:
//   1.20 +/- 0.13, z = +6.06, p = 0.00020 against a Bonferroni bar of 0.00057.
//   Half-split 2.44 early / 1.39 late against a base of 1.61 / 1.13 —
//   positive in both, but the late half is thin and the edge has narrowed.
// NOTE WHAT IT GIVES UP: it doubles LESS often than the unscreened base
// (8.3% against 12.1%). Its entire edge is the denominator.
sigOn    = not na(vol60) and not na(hi52) and hi52 >= sigHi and vol60 <= sigVol
sigFresh = sigOn and not sigOn[1]

bgcolor(showSig and sigOn ? color.new(color.teal, 92) : na, title = "screen active")
plotshape(showSig and sigFresh, "screen turns on", shape.triangleup,
          location.belowbar, color.new(color.teal, 20), size = size.tiny)
// NO ALERT ON THE STACK CROSSOVER, DELIBERATELY. The cross does not compound
// positively in both halves; the state does. An alert would turn a state into
// a trigger, which is precisely what the measurement says not to do.
alertcondition(sigFresh, "IDX strength+calm screen",
     "{{ticker}}: strength+calm screen turned on. Measured 1-year odds: " +
     "P(touch 2x) 8.3%, P(halve) 4.1%, skew 2.01. In-sample; not advice.")

plot(showSig ? ema50 : na, "EMA50", color.new(color.gray, 50))

// ------------------------------------------------------------- the panel ----
f_pos() =>
    panelPos == "Top right"    ? position.top_right    :
     panelPos == "Top left"    ? position.top_left     :
     panelPos == "Bottom right"? position.bottom_right : position.bottom_left
f_size() =>
    txtSize == "Tiny" ? size.tiny : txtSize == "Small" ? size.small : size.normal

var table P = table.new(f_pos(), 2, 25, border_width = 1)

f_row(int r, string k, string v, color c) =>
    table.cell(P, 0, r, k, text_size = f_size(), text_color = color.gray,
               text_halign = text.align_left)
    table.cell(P, 1, r, v, text_size = f_size(), text_color = c,
               text_halign = text.align_right)

f_head(int r, string t) =>
    table.cell(P, 0, r, t, text_size = f_size(), text_color = color.white,
               bgcolor = color.new(color.gray, 70), text_halign = text.align_left)
    table.cell(P, 1, r, "", text_size = f_size(),
               bgcolor = color.new(color.gray, 70))

if showPanel and barstate.islast
    table.clear(P, 0, 0, 1, 24)

    f_head(0, "STATE")
    f_row(1, "annualised vol (60b)", str.tostring(volAnn * 100, "#.0") + "%", color.white)
    f_row(2, "% of 52-week high", str.tostring(hi52 * 100, "#.1") + "%",
          hi52 >= 0.90 ? color.lime : color.white)
    f_row(3, "drawdown from peak", str.tostring(ddPk * 100, "#.1") + "%",
          ddPk < -0.20 ? color.orange : color.white)
    f_row(4, "sessions since high", str.tostring(barsSinceHi, "#"), color.white)
    f_row(5, "turnover (20b median)", "Rp " + str.tostring(rpDay / 1e9, "#.##") + "bn",
          color.white)

    f_head(6, "IDX MECHANICS  [exact]")
    f_row(7, "board", isThin ? "THIN +/-10%" : "main",
          isThin ? color.orange : color.white)
    f_row(8, "tick (fraksi harga)", "Rp " + str.tostring(tick, "#"), color.white)
    f_row(9, "max price step", "Rp " + str.tostring(maxStep, "#"), color.white)
    f_row(10, "ARA tomorrow", "Rp " + str.tostring(araLvl, "#") + "  (+" +
          str.tostring(araPct * 100, "#") + "%)", color.lime)
    f_row(11, "ARB tomorrow", "Rp " + str.tostring(arbLvl, "#") + "  (-" +
          str.tostring(arbPct * 100, "#") + "%)", color.red)
    f_row(12, "round trip (floor)", str.tostring(roundTrip * 100, "#.2") + "%",
          roundTrip > 0.015 ? color.orange : color.white)

    f_head(13, "MEASURED - 1 YEAR, IN-SAMPLE")
    f_row(14, "state bucket", bucketName, color.white)
    f_row(15, "P(touch 2x)", str.tostring(bucketUp * 100, "#.1") + "%", color.white)
    f_row(16, "P(end below half)", str.tostring(bucketDn * 100, "#.1") + "%", color.white)
    f_row(17, "asymmetry (up/down)", str.tostring(bucketSkew, "#.2") + "x",
          bucketSkew >= 1.5 ? color.lime : bucketSkew < 1.0 ? color.red : color.white)
    f_row(18, "base for any IDX name", "12.1% / 9.0% = 1.33x", color.gray)
    f_row(22, "60b fwd mean log, this state",
          str.tostring(stackLog, "#.####") + "  (base 0.0021)",
          stackLog > 0.015 ? color.lime : color.gray)
    f_row(23, showSig ? "screen" : "note",
          showSig ? (sigOn ? "ON  8.3%/4.1% = 2.01x" : "off")
                  : "in-sample - no magnitude forecast",
          showSig ? (sigOn ? color.teal : color.gray) : color.gray)
    f_row(19, ddPk < -0.02 ? "P(new high in 60b)" : "horizon check",
          ddPk < -0.02
            ? str.tostring(recOdds * 100, "#.0") + "%" + (emaBonus > 0 ? " (>EMA50)" : "")
            : "2x rate: 9.5% 1y -> 55.5% 10y",
          ddPk < -0.02 ? (recOdds >= 0.5 ? color.lime : color.orange) : color.gray)
    f_head(20, "EMA STACK  [H30, gridded on IDX]")
    f_row(21, "stack state", stackLbl + "  " + str.tostring(stackScore) + "/3",
          stackFull ? color.lime : stackOrd ? color.olive : color.gray)
