// =============================================================================
// IDX Leg Arrows - a green or red arrow when the leg is CONFIRMED
// =============================================================================
// The arrow marks the moment a trend is confirmed, not predicted. That
// distinction is the whole indicator:
//
//   * price has to move `band` off the running extreme before an arrow prints,
//     so the arrow is always AFTER the turn, by a known and bounded amount;
//   * once printed it NEVER moves. Measured across 43 IDX large caps over
//     14,854 hidden weeks, a leg that has closed never repaints - 43 of 43
//     names, and painting a half chart with only that half reproduces the full
//     chart's legs exactly.
//
// What the arrow is NOT
// ---------------------
// It is not a prediction and, on the evidence, not by itself a profitable
// entry. Measured on 40 IDX large caps at Rp10T+ from 2012, costs charged,
// against simply holding each name:
//
//     fast 12% alone       -1.85% a year, beat holding on 42% of names, 52 arrows
//     slow 25% alone       -1.54% a year, beat holding on 45% of names, 16 arrows
//     both bands agree     -1.90% a year, beat holding on 40% of names, 40 arrows
//
// Requiring agreement does NOT improve returns - it trades drawdown for them,
// cutting the median from -76% holding to -61%. So the filled arrow is a
// conviction marker about the TREND, not a better entry, and this header says
// so because the table above is the whole reason to be careful with it.
//
// The arrow tells you the picture has changed colour. It does not tell you that
// changing with it pays.
//
// Use it to know WHERE you are - in a confirmed up leg, a confirmed down leg,
// or in the still-unconfirmed middle - and to see the exact price at which that
// answer flips, which is arithmetic and shown live.
//
// CONVICTION
// ----------
// Two bands run at once. The fast band reacts sooner and whipsaws more; the
// slow one is late but rarely wrong. A FILLED arrow means both agree - the
// strongest reading the tool offers. A HOLLOW arrow means only the fast band
// has turned and the slow one has not confirmed yet.
//
// Install: TradingView -> Pine Editor -> paste -> Add to chart. Weekly chart.
// =============================================================================

//@version=5
indicator("IDX Leg Arrows", shorttitle="LEGS", overlay=true, max_labels_count=500)

// ---------------------------------------------------------------- inputs ----
fastPct  = input.float(12.0, "Fast confirmation band (%)", minval=2, maxval=60, step=1,
   tooltip="12% reproduces the hand-drawn weekly swings on IDX large caps. Smaller reacts sooner and whipsaws more.")
slowPct  = input.float(25.0, "Slow confirmation band (%)", minval=2, maxval=80, step=1,
   tooltip="The agreement band. 25% was the least-bad setting in testing - still short of buy-and-hold.")
useSlow  = input.bool(true,  "Require the slow band for a filled arrow")
showTrig = input.bool(true,  "Show the price that flips the signal")
showZone = input.bool(true,  "Shade the confirmed leg")

// ------------------------------------------------------- the state machine --
// Running extreme since the last confirmation. Reset ON confirmation so the lag
// stays bounded by the band and cannot compound.
band_state(float src, float pct) =>
    var bool  isUp = false
    var float ext  = na
    ext := na(ext) ? src : ext
    if isUp
        if src > ext
            ext := src
        else if 1.0 - src / ext >= pct / 100.0
            isUp := false
            ext  := src
    else
        if src < ext
            ext := src
        else if src / ext - 1.0 >= pct / 100.0
            isUp := true
            ext  := src
    trig = isUp ? ext * (1.0 - pct / 100.0) : ext * (1.0 + pct / 100.0)
    [isUp, ext, trig]

[fastUp, fastExt, fastTrig] = band_state(close, fastPct)
[slowUp, slowExt, slowTrig] = band_state(close, slowPct)

fastFlipUp = fastUp and not fastUp[1]
fastFlipDn = not fastUp and fastUp[1]
agree      = not useSlow or (fastUp == slowUp)

// ------------------------------------------------------------- rendering ----
bg = showZone ? (fastUp ? color.new(color.green, 92) : color.new(color.red, 93)) : na
bgcolor(bg, title="confirmed leg")

plotshape(fastFlipUp and agree,  "UP confirmed",  shape.triangleup,   location.belowbar,
   color.new(color.green, 0),  size=size.normal)
plotshape(fastFlipUp and not agree, "UP, fast only", shape.triangleup, location.belowbar,
   color.new(color.green, 55), size=size.small)
plotshape(fastFlipDn and agree,  "DOWN confirmed", shape.triangledown, location.abovebar,
   color.new(color.red, 0),    size=size.normal)
plotshape(fastFlipDn and not agree, "DOWN, fast only", shape.triangledown, location.abovebar,
   color.new(color.red, 55),   size=size.small)

plot(showTrig ? fastTrig : na, "flips at", color=color.new(color.blue, 30),
   linewidth=1, style=plot.style_stepline)

// how old is the current leg, in bars
var int legStart = 0
if fastFlipUp or fastFlipDn
    legStart := bar_index

// ---------------------------------------------------------------- readout ---
var table t = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    conf = fastUp == slowUp ? "BOTH BANDS AGREE" : "fast band only"
    table.cell(t, 0, 0, "IDX LEG ARROWS", text_color=color.white,
       bgcolor=color.new(color.blue, 30), text_size=size.small)
    table.cell(t, 1, 0, fastUp ? "UP LEG" : "DOWN LEG", text_color=color.white,
       bgcolor=fastUp ? color.new(color.green, 15) : color.new(color.red, 15),
       text_size=size.small)
    table.cell(t, 0, 1, "conviction", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1, conf, text_size=size.tiny,
       text_color=fastUp == slowUp ? color.white : color.gray)
    table.cell(t, 0, 2, "confirmed for", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2, str.tostring(bar_index - legStart) + " bars", text_size=size.tiny)
    table.cell(t, 0, 3, "flips at", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3, str.tostring(fastTrig, format.mintick), text_size=size.tiny)
    table.cell(t, 0, 4, "move needed", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4, str.tostring((fastTrig / close - 1.0) * 100.0, "#.#") + "%",
       text_color=fastUp ? color.red : color.green, text_size=size.tiny)
    table.cell(t, 0, 5, "arrows never repaint", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5, "confirmation, not forecast", text_color=color.gray,
       text_size=size.tiny)

alertcondition(fastFlipUp and agree,  "Leg confirmed UP",
   "Both bands agree: confirmed UP leg")
alertcondition(fastFlipDn and agree,  "Leg confirmed DOWN",
   "Both bands agree: confirmed DOWN leg")
alertcondition(fastFlipUp or fastFlipDn, "Leg flipped (fast band)",
   "Fast band flipped - slow band may not agree yet")
