__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# Cached market data and generated reports are reproducible; keep the dirs.
data/cache/
data/broker_summary/*
!data/broker_summary/.gitkeep
reports/*
# Generated artefacts above are reproducible. Phase MEMOS are not - they are
# the deliverable CLAUDE.md §14 defines, hand-written, and must be tracked.
!reports/*.md
!reports/backtest_real.txt
!reports/data_availability.csv
# ... except the DAILY BRIEF, which is regenerated output that happens to be
# markdown. The phase memos are the deliverable; a dated brief is scrollback.
reports/brief_*.md
reports/brief_*.html

data/Dataset-Saham-IDX/

# Derived cache: the per-broker window frame is a pure function of
# data/cache/ipot_broker and is rebuilt with `persistence.py --rebuild`.
# flow_panel.csv.gz stays tracked because it is the Phase 1 panel itself.
data/spine/broker_windows.csv.gz
# 267MB and a pure function of the OHLCV stores; rebuild with
# `python3 scripts/price_panel_build.py`. Over GitHub's file limit anyway.
data/spine/price_panel.parquet
# Derived from the panel + the OHLCV cache by scripts/build_indicators.py
# in about five minutes; 216MB of reproducible floats does not belong in git.
data/spine/indicator_panel.parquet
# Likewise the H19 state panel, rebuilt by scripts/recovery.py --rebuild.
data/spine/recovery_state_*.parquet
# Likewise the H20 per-name return table, rebuilt by scripts/portfolio_sim.py
# (drop --report) in about twenty minutes from the panel and the indicators.
data/spine/portfolio_names.parquet
# And the liquid-tercile re-rank table, rebuilt by scripts/liquid_rerank.py
# (drop --report) in about ten minutes from the panel.
data/spine/liquid_rerank.parquet
# And the H23 horizon table, rebuilt by scripts/horizon_sweep.py (drop
# --report) in about five minutes from the panel.
data/spine/horizon_sweep.parquet
